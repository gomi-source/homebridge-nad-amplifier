{
  "name": "homebridge-nad-amplifier",
  "displayName": "NAD Amplifier",
  "type": "module",
  "version": "0.6.0",
  "description": "Homebridge plugin to control a NAD BluOS amplifier (e.g. M33) from Apple Home, via MQTT.",
  "author": "Anders Ljungh",
  "license": "Apache-2.0",
  "homepage": "https://github.com/USERNAME/homebridge-nad-amplifier#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/USERNAME/homebridge-nad-amplifier.git"
  },
  "bugs": {
    "url": "https://github.com/USERNAME/homebridge-nad-amplifier/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "nad",
    "bluos",
    "amplifier",
    "mqtt"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
